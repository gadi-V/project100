# PostgreSQL connection string (Neon, Supabase, local Postgres, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Secret for signing session JWT cookies (generate with: openssl rand -hex 32)
AUTH_SECRET="your-random-secret-here"

# Daily.co — REST API key from https://dashboard.daily.co/developers
# Used server-side to create private rooms, meeting tokens, and recording access links.
DAILY_API_KEY=your_daily_api_key_here

# Daily.co webhook HMAC secret (base64) returned when creating the webhook.
# Used to verify X-Webhook-Signature on POST /api/webhooks/daily.
DAILY_WEBHOOK_SECRET=your_daily_webhook_hmac_base64_secret

# Stream Chat — https://dashboard.getstream.io/
# Public key is safe in the browser; secret must stay server-only.
NEXT_PUBLIC_STREAM_API_KEY=your_stream_api_key
STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_api_secret

# Public app origin (used for WhatsApp deep-links + secure recording links)
APP_URL=http://localhost:3000

# Stripe Checkout — credits are granted only after webhook verification
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# SMS OTP (Twilio preferred; generic SMS_API_* as alternative)
# Console fallback for OTP is allowed only when NODE_ENV=development
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# SMS_API_URL=
# SMS_API_KEY=

# File storage for lesson board PDFs (Supabase Storage via REST).
# Create a bucket (default: lesson-boards). Use the SERVICE ROLE key server-side only.
# If left unset, uploads fall back to mock mode (PDF still sent via WhatsApp document).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=lesson-boards
# Set to "false" for a private bucket (URLs will be time-limited signed links)
SUPABASE_STORAGE_PUBLIC=true
# Signed URL lifetime in seconds (used only when SUPABASE_STORAGE_PUBLIC=false)
SUPABASE_SIGNED_URL_TTL=604800

# WhatsApp API (Green API / Twilio / compatible gateway) — unidirectional system alerts only.
# Bidirectional chat stays in-app via Stream Chat; never relay participant phone numbers.
WHATSAPP_API_URL=your_whatsapp_api_url
WHATSAPP_API_KEY=your_whatsapp_api_key

# Cron auth — Vercel Cron sends `Authorization: Bearer $CRON_SECRET` automatically,
# and the QStash schedules forward the same header. Generate with: openssl rand -hex 32
CRON_SECRET=your_cron_secret_here

# Upstash QStash — drives the 5-minute lesson reminders (npm run qstash:schedules).
# QSTASH_TOKEN is only needed where you run the setup script.
QSTASH_TOKEN=your_qstash_token_here
# Optional at runtime: lets cron routes also accept QStash-signed deliveries
# (Upstash console → QStash → Signing Keys). Bearer CRON_SECRET works without them.
QSTASH_CURRENT_SIGNING_KEY=your_qstash_current_signing_key_here
QSTASH_NEXT_SIGNING_KEY=your_qstash_next_signing_key_here

# Upstash Redis — distributed rate limiting in middleware (lib/security/rate-limit.ts).
# Strongly recommended in production: when unset there, requests fail open (NOT rate limited)
# and a "[rate-limit] DEGRADED" console.error is logged at most once a minute per instance.
# Outside production the limiter is bypassed with a one-time warning.
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# ── Agent Hive (FastMCP) ─────────────────────────────────────────────────────
# Server-side key used by lib/curriculum-agent.ts. Must be set here / in the platform env:
# the Next.js app no longer reads agents_hive/.env (that file is for the Python Hive only).
OPENROUTER_API_KEY="sk-or-v1-placeholder"
# Optional: syllabus-parse timeout in ms (default 45000, no retries).
# CURRICULUM_AGENT_TIMEOUT_MS=45000
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model aliases used by agents_hive (architect/model per role).
MODEL_ARCHITECT=deepseek/deepseek-r1
MODEL_QA=deepseek/deepseek-r1
MODEL_SECURITY=deepseek/deepseek-r1
MODEL_MEDIA=deepseek/deepseek-chat
MODEL_FINTECH=deepseek/deepseek-chat
MODEL_AUTOMATION=deepseek/deepseek-chat
MODEL_FRONTEND=deepseek/deepseek-chat
MODEL_DELIVERY=deepseek/deepseek-chat
MODEL_CREATIVE=openai/gpt-4o-mini

# ── Head of Desk quiet monitor (server-to-server auth) ────────────────────────
# Shared secret between /api/cron/head-of-desk and /api/admin/audit/risk-events.
# Generate with: openssl rand -hex 32
HIVE_MONITOR_SECRET=your_hive_monitor_secret_here

# Day.co cloud recording opt-in (paid feature on the Daily plan).
# Set to "true" only when your plan supports cloud recordings.
DAILY_ENABLE_CLOUD_RECORDING=false

# Application URLs
NEXT_PUBLIC_APP_URL="https://project100.vercel.app"

# Service-to-Service Security
INTERNAL_SERVICE_KEY="change_me_internal_service_key"

# WhatsApp & Admin Routing — replace with real numbers (any format; normalized to E.164).
# Leave empty to omit that member from Quad groups (no fake fallbacks are used).
WHATSAPP_ADMIN_PHONE="+972500000001"
WHATSAPP_TEACHER_PLACEHOLDER_PHONE="+972500000002"

# Daily Video Infrastructure (teacher permanent room links)
DAILY_DOMAIN="project100.daily.co"

# AI / OpenRouter — OPENROUTER_API_KEY is defined in the Agent Hive section above.

# Onboarding Assets
NEXT_PUBLIC_EXAM_581_PDF_URL="https://storage.googleapis.com/placeholder/exam-581.pdf"

# Telegram Manager Alerts
TELEGRAM_BOT_TOKEN="0000000000:AAEngagementBotPlaceholderToken"
MANAGER_ALERT_PHONE="+972500000000"
MANAGER_ALERT_TELEGRAM_CHAT_ID="000000000"
