generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  TEACHER
  STUDENT
  /// Intake representative: runs the mapping call and records IntakeAssessment. Assigned by an admin only.
  REPRESENTATIVE
}

enum TeacherVettingStage {
  REGISTRATION
  SCREENING
  SIMULATION
  EXAM_581
  FINAL_VIDEO
  APPROVED
  REJECTED
  // Historic values kept for backward compatibility with previously deployed rows.
  // Additive-only: never drop. New code uses REGISTRATION..REJECTED.
  APPLIED
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  SIMULATION_PASSED
  PEDAGOGY_TEST_PASSED
  TERMS_AGREED
}

model User {
  id       String  @id @default(uuid())
  name     String
  phone    String  @unique
  email    String? @unique
  password String
  role     Role    @default(STUDENT)

  lessonCredits Int     @default(0)
  isApproved    Boolean @default(false)

  // Student diagnostic & context fields
  parentName              String?
  parentPhone             String?
  schoolName              String?
  classTrack              String?
  trackType               String?
  degreeField             String?
  academicYear            String?
  targetOrganization      String?
  quadGroupUrl            String?
  /// Live quad WhatsApp group chat id (`…@g.us`), set when the group is opened; future group messages target it.
  whatsappGroupId         String?
  /// Opt-in flag so the funnel only notifies via WhatsApp when a parent phone was supplied.
  notifyParentViaWhatsApp Boolean @default(false)

  givenLessons               Lesson[]                  @relation("TeacherLessons")
  takenLessons               Lesson[]                  @relation("StudentLessons")
  availabilities             TeacherAvailability[]
  diagnosticQuizzes          DiagnosticQuiz[]
  payments                   Payment[]
  teacherProfile             TeacherProfile?
  auditLogs                  AuditLog[]
  referralsAsTeacher         TeacherReferral[]         @relation("TeacherReferrals")
  referralsAsStudent         TeacherReferral[]         @relation("StudentReferrals")
  payouts                    TeacherPayout[]
  ledgerEntries              BillingLedger[]
  uploadedAssets             PreLessonAsset[]
  intakeAssessments          IntakeAssessment[]        @relation("StudentIntakeAssessments")
  conductedIntakeAssessments IntakeAssessment[]        @relation("RepresentativeIntakeAssessments")
  studentProfile             StudentProfile?
  communicationLogs          StudentCommunicationLog[]

  createdAt DateTime @default(now())
}

/// CRM card of a student in the staff portal (`/portal/students/[id]`). Name, phone, email, school and
/// parent contact stay on `User`; this table holds the extra personal / invoice fields and the status flags.
model StudentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName    String?
  lastName     String?
  grade        String?
  /// הקבצה / יח״ל
  studyGroup   String?
  nationalId   String?
  city         String?
  birthDate    DateTime?
  /// Full name and ID / company number printed on the parent's invoice.
  invoiceName  String?
  invoiceTaxId String?

  /// Customer status flags (codes from `lib/student-portal-shared.ts`, e.g. STUDENT, CALL_BACK_PARENT, BOILING_160).
  studentStatus     String[]  @default([])
  statusUpdatedAt   DateTime?
  statusUpdatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Summary / message recorded on a student's communication tab (lesson, mapping, post-mapping call, general).
model StudentCommunicationLog {
  id             String   @id @default(cuid())
  studentId      String
  student        User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  authorId       String
  authorName     String
  /// TEACHER | REPRESENTATIVE | ADMIN | PEDAGOGIC_MANAGER
  authorRole     String
  /// LESSON_SUMMARY | MAPPING_SUMMARY | POST_MAPPING_CALL | GENERAL
  type           String
  /// e.g. "שיעור מיפוי ראשוני - גדי" or the subject name.
  courseContext  String?
  content        String   @db.Text
  /// Template fields parsed from `content` (see `lib/communication-templates.ts`).
  structuredData Json?
  createdAt      DateTime @default(now())

  @@index([studentId, createdAt])
}

model TeacherProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjects           String[] // מקצועות: מתמטיקה, פיזיקה, אינפי...
  ageGroups          String[]             @default([]) // יסודי / חטיבה / תיכון / אקדמיה
  bio                String?
  profileImageUrl    String?
  // Granular topic proficiencies (e.g. topic IDs or names with mastery level / score)
  topicProficiencies Json?
  vettingStage       TeacherVettingStage?

  cvUrl           String?
  vettingStatus   VettingStatus    @default(PENDING)
  vettingNotes    String?          @db.Text
  payoutType      PayoutType       @default(SLIP)
  isApproved      Boolean          @default(false)
  vettingStepLogs VettingStepLog[]

  /// Bank details for tutor payouts (manual settle by admin).
  bankName          String?
  bankBranch        String?
  accountNumber     String?
  accountHolderName String?

  /// Permanent Daily.co classroom assigned on approval (teacher welcome envelope).
  permanentRoomUrl    String?
  /// When the automated welcome pack was dispatched (audit anchor).
  welcomePackSentAt   DateTime?
  /// Whether the teacher joined the 50-hour training track (activated by welcome envelope).
  trainingTrackJoined Boolean   @default(false)

  // מדדי חלוקה שוויונית
  referralCount       Int       @default(0)
  activeStudentsCount Int       @default(0)
  lastReferralAt      DateTime?
  /// Match score of the most recent referral for this teacher.
  lastMatchScore      Int?

  /// Aggregated rating from student reviews (1–5 scale).
  averageRating Float @default(5.0)
  totalReviews  Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeacherReferral {
  id           String  @id @default(uuid())
  teacherId    String
  studentId    String
  diagnosticId String?
  matchScore   Int     @default(0)
  reason       String?

  teacher User @relation("TeacherReferrals", fields: [teacherId], references: [id], onDelete: Cascade)
  student User @relation("StudentReferrals", fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([teacherId, createdAt])
  @@index([studentId, createdAt])
}

model TeacherAvailability {
  id        String @id @default(uuid())
  teacherId String
  teacher   User   @relation(fields: [teacherId], references: [id])

  startTime DateTime
  endTime   DateTime

  isBooked Boolean @default(false)
}

model Lesson {
  id String @id @default(uuid())

  title     String?
  startTime DateTime?
  endTime   DateTime?

  teacherId String
  teacher   User   @relation("TeacherLessons", fields: [teacherId], references: [id])

  studentId String
  student   User   @relation("StudentLessons", fields: [studentId], references: [id])

  scheduledAt         DateTime
  status              String    @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED, CANCELLED_LATE
  reminderSent        Boolean   @default(false)
  /// When the lesson was cancelled (null unless cancelled).
  canceledAt          DateTime?
  /// User id that issued the cancellation.
  canceledById        String?
  /// Original teacher before a same-day substitute reassignment (null unless replaced).
  originalTeacherId   String?
  /// Teacher that stepped in for a same-day substitute (recorded when teacher != originalTeacherId).
  substituteTeacherId String?
  /// Fine appeal state. NONE = no appeal, PENDING = teacher requested, APPROVED/REJECTED by a manager.
  appealStatus        String    @default("NONE") // NONE, PENDING, APPROVED, REJECTED
  /// Planned duration in minutes (null = fallback to 60). Room `exp` = scheduledAt + duration + 10%.
  durationMinutes     Int?      @default(60)
  /// Daily.co room URL for the virtual classroom (DB column retained as zoomLink for compatibility).
  dailyRoomUrl        String?   @map("zoomLink")

  excalidrawPdfUrl  String?
  videoRecordingUrl String?

  /// Student rating after lesson completion (1–5 stars).
  rating        Int?
  reviewComment String?
  ratedAt       DateTime?

  /// How many times this lesson has been rescheduled (max 1).
  rescheduledCount Int @default(0)

  packageId String?
  package   Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  /// Post-lesson pedagogical summary (teacher entered after the lesson).
  pedagogicalBrief String? @db.Text

  /// Attendance marked from the staff portal: PRESENT | ABSENT (null = not marked). Independent of `status`.
  attendanceStatus     String?
  attendanceMarkedAt   DateTime?
  attendanceMarkedById String?

  /// MAPPING (initial mapping lesson scheduled from the staff portal) | REGULAR.
  lessonType      String  @default("REGULAR")
  /// Quad WhatsApp group (`…@g.us`) that was opened or notified when this lesson was scheduled.
  whatsappGroupId String?

  chatChannel ChatChannel?
  payouts     TeacherPayout[]

  createdAt       DateTime         @default(now())
  preLessonAssets PreLessonAsset[]
}

model ChatChannel {
  id              String @id @default(uuid())
  lessonId        String @unique
  lesson          Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  streamChannelId String @unique

  createdAt DateTime @default(now())
}

model Package {
  id       String  @id @default(uuid())
  code     String  @unique
  name     String
  credits  Int     @default(0)
  priceIls Int     @default(0)
  currency String  @default("ILS")
  isActive Boolean @default(true)

  chat            UnifiedPackageChat?
  lessons         Lesson[]
  preLessonAssets PreLessonAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id            String @id @default(uuid())
  studentId     String
  student       User   @relation(fields: [studentId], references: [id])
  packageType   String
  amountPaid    Int
  creditsAdded  Int
  transactionId String
  /// PENDING | COMPLETED | REFUNDED — mock/dev and Stripe webhook write COMPLETED
  status        String @default("COMPLETED")

  createdAt DateTime @default(now())
}

model FallbackLead {
  id             String  @id @default(uuid())
  name           String
  phone          String
  grade          String
  requestedHours String
  isHandled      Boolean @default(false)

  intakeAssessments IntakeAssessment[]

  createdAt DateTime @default(now())
}

/// Mapping-call questionnaire (student + parent) recorded by a representative.
/// Linked to a registered student and/or a web lead; `POST /api/admin/intake` requires at least one.
model IntakeAssessment {
  id String @id @default(uuid())

  studentId        String?
  student          User?         @relation("StudentIntakeAssessments", fields: [studentId], references: [id], onDelete: Cascade)
  fallbackLeadId   String?
  fallbackLead     FallbackLead? @relation(fields: [fallbackLeadId], references: [id], onDelete: Cascade)
  /// Staff member who held the call (taken from the session, never from the request body).
  representativeId String?
  representative   User?         @relation("RepresentativeIntakeAssessments", fields: [representativeId], references: [id], onDelete: SetNull)

  // --- Student intake ---
  grade                  String
  levelUnits             String
  hobbies                String
  isProfessionalHobby    Boolean
  weeklyHobbyFrequency   Int?
  nextExamDate           DateTime?
  lastExamDate           DateTime?
  lastExamScore          Float?
  strongTopic            String
  weakTopic              String
  focusRequest           String?
  mathPerception         String
  classListening         String
  pastAssistance         String
  pastAssistanceDuration String?
  mainGoals              String
  firstMonthTarget       String
  studentImportantNotes  String?

  // --- Parent intake ---
  parentMainGoalYear       String
  parentTargetScore        Float?
  parentAverageScore       Float?
  motivationLevel          String
  successDefinition        String
  homeStudyTime            String
  hasQuietSpace            Boolean
  hasWorkingEquipment      Boolean
  siblingsDetails          String?
  learningDisabilities     String?
  emotionalDifficulties    String?
  pastAssistanceExperience String?
  /// 1–5
  progressFeltRating       Int?
  whatWorkedOrFailed       String?
  homeLanguage             String?
  /// 1–5
  parentInvolvementLevel   Int?
  parentImportantNotes     String?
  representativeNotes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, createdAt])
  @@index([fallbackLeadId, createdAt])
  @@index([representativeId])
}

model DiagnosticQuiz {
  id        String @id @default(uuid())
  studentId String

  ageGroup  String
  subject   String
  challenge String
  topicIds  String[]          @default([])
  topics    CurriculumTopic[]

  // --- Diagnostic Quiz Engine (additive) ---
  packageId      String?
  topic          String?
  score          Int?
  totalQuestions Int?
  answersSummary String?
  identifiedGaps String[] @default([])

  /// Gating and readiness scores
  estimatedScore        Int?      @default(0)
  isUnlocked            Boolean   @default(false)
  unlockedAt            DateTime?
  recommendationSummary String?

  /// 5-Step Funnel tracking fields
  hasUpcomingExam Boolean @default(false)
  examTimeframe   String?
  learningGoal    String?
  lastGrade       Int?
  challengeAnswer String?

  schoolName String?
  classTrack String?

  /// Adaptive Multi-Track taxonomy fields (Step 5.2)
  trackType           String?
  examNumber          String?
  unitsCount          Int?
  degreeField         String?
  academicYear        String?
  coreCourse          String?
  mechinaTrack        String?
  isFirstAttempt      Boolean?
  psychometricTotal   Int?
  psychometricQuant   Int?
  psychometricVerbal  Int?
  psychometricEnglish Int?
  targetTestSession   String?
  targetOrganization  String?
  testingInstitute    String?
  examBattery         String?

  quadGroupUrl String?

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model CurriculumTopic {
  id           String   @id @default(uuid())
  subject      String
  topicName    String
  subTopics    Json     @default("[]")
  gradeLevel   String   @default("HIGH_SCHOOL")
  weightInExam Float    @default(1.0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  diagnosticQuizzes DiagnosticQuiz[]

  @@index([subject])
  @@index([gradeLevel])
}

model AuditLog {
  id         String  @id @default(uuid())
  actorId    String?
  actor      User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?

  createdAt DateTime @default(now())
}

model WebhookEvent {
  id          String    @id @default(uuid())
  provider    String
  eventType   String
  externalId  String    @unique
  payload     Json
  processed   Boolean   @default(false)
  processedAt DateTime?
  error       String?

  createdAt DateTime @default(now())
}

model OtpCode {
  id        String    @id @default(uuid())
  phone     String
  codeHash  String
  purpose   String    @default("PASSWORD_RESET")
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)

  createdAt DateTime @default(now())

  @@index([phone, purpose, createdAt])
}

// --- New: Payout & Vetting Workflow Enums ---

enum PayoutType {
  SLIP
  INVOICE
}

enum VettingStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
}

enum VettingStepName {
  REGISTRATION_AND_CV
  SCREENING_CALL
  TEACHING_SIMULATION
  EXAM_581
  FINAL_VIDEO_CALL
  FINAL_APPROVAL
}

enum VettingStepStatus {
  PENDING
  PASSED
  FAILED
  SKIPPED
  /// Submitted by the teacher but awaiting the admin/manager review (e.g. exam 581).
  PENDING_REVIEW
}

enum PreLessonAssetType {
  IMAGE
  PDF
  TEXT_NOTE
}

model VettingStepLog {
  id                 String            @id @default(uuid())
  teacherProfileId   String
  teacherProfile     TeacherProfile    @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  stepNumber         Int
  stepName           VettingStepName
  status             VettingStepStatus @default(PENDING)
  adminNotes         String?           @db.Text
  bypassedByAdmin    Boolean           @default(false)
  evaluatedByAdminId String?
  completedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([teacherProfileId, stepNumber])
  @@index([teacherProfileId, status])
}

// ─── Financial Models (Immutable Ledger + Payouts) ───

enum PayoutStatus {
  SCHEDULED
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

enum LedgerEntryType {
  CHARGE
  PAYOUT
  REFUND
  PLATFORM_FEE
  ADJUSTMENT
  PENALTY
  COMPENSATION
  PLATFORM_COMPENSATION
}

model TeacherPayout {
  id             String       @id @default(uuid())
  teacherId      String
  teacher        User         @relation(fields: [teacherId], references: [id])
  amount         Decimal      @db.Decimal(19, 4)
  currency       String       @default("ILS")
  status         PayoutStatus @default(SCHEDULED)
  periodStart    DateTime
  periodEnd      DateTime
  idempotencyKey String       @unique
  metadata       Json?
  lessonId       String?
  lesson         Lesson?      @relation(fields: [lessonId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
  @@index([status])
  @@index([periodEnd])
}

model BillingLedger {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  entryType     LedgerEntryType
  amount        Decimal         @db.Decimal(19, 4)
  currency      String          @default("ILS")
  description   String?
  relatedId     String? // paymentId, payoutId, lessonId
  transactionId String?         @unique
  metadata      Json?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entryType])
  @@index([relatedId])
}

model UnifiedPackageChat {
  id              String           @id @default(uuid())
  packageId       String           @unique
  package         Package          @relation(fields: [packageId], references: [id], onDelete: Cascade)
  streamChannelId String?          @unique
  isActive        Boolean          @default(true)
  preLessonAssets PreLessonAsset[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([packageId])
}

model PreLessonAsset {
  id           String              @id @default(uuid())
  packageId    String
  package      Package             @relation(fields: [packageId], references: [id], onDelete: Cascade)
  lessonId     String?
  lesson       Lesson?             @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  chatId       String?
  chat         UnifiedPackageChat? @relation(fields: [chatId], references: [id], onDelete: SetNull)
  assetType    PreLessonAssetType  @default(IMAGE)
  assetUrl     String?
  textContent  String?             @db.Text
  uploadedById String
  uploadedBy   User                @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime            @default(now())

  @@index([packageId])
  @@index([lessonId])
}
